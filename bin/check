#!/bin/sh
# The definition of done. Every CI job is a thin wrapper over this script, so a
# green run here predicts a green pipeline.
#
# Hard requirement: this must need no network and nothing installed beyond what
# corax itself needs. shellcheck and jq are used when present and skipped when
# not, so a contributor on a bare machine can still run it. If a change makes
# bin/check slow or dependent on a download, the change is wrong, not the script.
#
# Exits 0 when everything passes, 1 on the first failure.
set -eu

cd "$(dirname "$0")/.."

run() { printf '\n==> %s\n' "$1"; shift; "$@"; }

SHELLS='sh bash'
for s in $SHELLS; do
  command -v "$s" >/dev/null 2>&1 || continue
  run "parse ($s)" "$s" -n corax
  "$s" -n install.sh
  "$s" -n tests/run.sh
  "$s" -n bin/check
done

if command -v dash >/dev/null 2>&1; then
  run "parse (dash, the strictest POSIX shell we target)" dash -n corax
fi

run "json is well formed" sh -c '
  for f in .claude-plugin/plugin.json .claude-plugin/marketplace.json \
           hooks/hooks.json package.json; do
    if command -v python3 >/dev/null 2>&1; then
      python3 -c "import json,sys;json.load(open(sys.argv[1]))" "$f"
    elif command -v jq >/dev/null 2>&1; then
      jq -e . "$f" >/dev/null
    else
      echo "   (skipped $f: no python3 or jq)"
      continue
    fi
    echo "   ok $f"
  done'

run "versions agree" sh -c '
  s=$(sed -n "s/^CORAX_VERSION=//p" corax | head -1)
  for f in package.json .claude-plugin/plugin.json; do
    v=$(sed -n "s/.*\"version\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$f" | head -1)
    [ "$v" = "$s" ] || { echo "   $f says $v, corax says $s"; exit 1; }
    echo "   ok $f $v"
  done'

if command -v shellcheck >/dev/null 2>&1; then
  run "shellcheck" shellcheck -s sh corax install.sh tests/run.sh
else
  printf '\n==> shellcheck\n   (not installed, skipped; CI runs it)\n'
fi

run "tests" sh tests/run.sh

printf '\nall green\n'
